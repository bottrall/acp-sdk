class ACP::AgentConnection
  interface _Agent
    def new_session: (ACP::Types::NewSessionRequest) -> (ACP::Types::NewSessionResponse | ACP::RequestError)
    def prompt: (ACP::Types::PromptRequest) -> (ACP::Types::PromptResponse | ACP::RequestError)
    # Runs on the transport's reader thread, so it must return quickly.
    def cancel: (ACP::Types::CancelNotification) -> void
    # AgentConnection probes for the optional methods below.
    def respond_to?: (Symbol) -> bool
  end

  interface _LoadSession
    def load_session: (ACP::Types::LoadSessionRequest) -> (ACP::Types::LoadSessionResponse | ACP::RequestError)
  end

  interface _ListSessions
    def list_sessions: (ACP::Types::ListSessionsRequest) -> (ACP::Types::ListSessionsResponse | ACP::RequestError)
  end

  interface _Authenticate
    def authenticate: (ACP::Types::AuthenticateRequest) -> (ACP::Types::AuthenticateResponse | ACP::RequestError)
  end

  interface _ResumeSession
    def resume_session: (ACP::Types::ResumeSessionRequest) -> (ACP::Types::ResumeSessionResponse | ACP::RequestError)
  end

  interface _CloseSession
    def close_session: (ACP::Types::CloseSessionRequest) -> (ACP::Types::CloseSessionResponse | ACP::RequestError)
  end

  interface _DeleteSession
    def delete_session: (ACP::Types::DeleteSessionRequest) -> (ACP::Types::DeleteSessionResponse | ACP::RequestError)
  end

  interface _Logout
    def logout: (ACP::Types::LogoutRequest) -> (ACP::Types::LogoutResponse | ACP::RequestError)
  end

  interface _ChangeSessionMode
    def change_session_mode: (ACP::Types::SetSessionModeRequest) -> (ACP::Types::SetSessionModeResponse | ACP::RequestError)
  end

  interface _ChangeSessionConfigOption
    def change_session_config_option: (ACP::Types::SetSessionConfigOptionRequest) -> (ACP::Types::SetSessionConfigOptionResponse | ACP::RequestError)
  end

  interface _FullAgent
    include _Agent
    include _LoadSession
    include _ListSessions
    include _Authenticate
    include _ResumeSession
    include _CloseSession
    include _DeleteSession
    include _Logout
    include _ChangeSessionMode
    include _ChangeSessionConfigOption
  end

  interface _OptionalMethod
    def rpc_method: () -> String
    def agent_method: () -> Symbol
    def advertised?: (ACP::Types::InitializeResponse) -> bool
  end

  interface _SessionCreated
    def session_created: (ACP::Types::NewSessionResponse) -> void
  end

  # What an agent sees of ACP::AgentConnection::Client, so tests can pass a fake.
  interface _Client
    def update: (String session_id, ACP::Types::SessionUpdate::t update) -> void
    def available_commands: (String session_id, Array[ACP::Types::AvailableCommand] commands) -> void
    def request_permission: (ACP::Types::RequestPermissionRequest) -> (ACP::Types::RequestPermissionResponse | ACP::RequestError)
    def read_text_file: (ACP::Types::ReadTextFileRequest) -> (ACP::Types::ReadTextFileResponse | ACP::RequestError)
    def write_text_file: (ACP::Types::WriteTextFileRequest) -> (ACP::Types::WriteTextFileResponse | ACP::RequestError)
    def create_terminal: (ACP::Types::CreateTerminalRequest) -> (ACP::Types::CreateTerminalResponse | ACP::RequestError)
    def terminal_output: (ACP::Types::TerminalOutputRequest) -> (ACP::Types::TerminalOutputResponse | ACP::RequestError)
    def wait_for_terminal_exit: (ACP::Types::WaitForTerminalExitRequest) -> (ACP::Types::WaitForTerminalExitResponse | ACP::RequestError)
    def kill_terminal: (ACP::Types::KillTerminalRequest) -> (ACP::Types::KillTerminalResponse | ACP::RequestError)
    def release_terminal: (ACP::Types::ReleaseTerminalRequest) -> (ACP::Types::ReleaseTerminalResponse | ACP::RequestError)
    def create_elicitation: (ACP::Types::CreateElicitationRequest request) -> (ACP::Types::CreateElicitationResponse | ACP::RequestError)
    def complete_elicitation: (ACP::Types::CompleteElicitationNotification notification) -> void
    def ext_request: (String method, ?untyped params) -> (Hash[String, untyped] | ACP::RequestError)
    def ext_notify: (String method, ?untyped params) -> void
    def capabilities: () -> ACP::Types::ClientCapabilities?
  end

  interface _Peer
    def request: (String method, ?untyped params) -> (Hash[String, untyped] | ACP::RequestError)
    def notify: (String method, ?untyped params) -> void
  end

  interface _Transport
    include _Peer

    def start: (
      requests: Hash[String, ACP::Transport::Stdio::_Handler],
      notifications: Hash[String, ACP::Transport::Stdio::_NotificationHandler]
    ) -> Thread
  end

  interface _Parser
    def from_h: (Hash[String, untyped]) -> untyped
  end

  interface _Response
    def to_h: () -> Hash[String, untyped]
  end
end
