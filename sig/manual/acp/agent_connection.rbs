class ACP::AgentConnection
  interface _Agent
    def new_session: (ACP::Types::NewSessionRequest) -> (ACP::Types::NewSessionResponse | ACP::RequestError)
    def prompt: (ACP::Types::PromptRequest) -> (ACP::Types::PromptResponse | ACP::RequestError)
    # Runs on the transport's reader thread, so it must return quickly.
    def cancel: (ACP::Types::CancelNotification) -> void
    # AgentConnection probes for the optional methods below.
    def respond_to?: (Symbol) -> bool
  end

  interface _LoadSession
    def load_session: (ACP::Types::LoadSessionRequest) -> (ACP::Types::LoadSessionResponse | ACP::RequestError)
  end

  interface _ListSessions
    def list_sessions: (ACP::Types::ListSessionsRequest) -> (ACP::Types::ListSessionsResponse | ACP::RequestError)
  end

  interface _Authenticate
    def authenticate: (ACP::Types::AuthenticateRequest) -> (ACP::Types::AuthenticateResponse | ACP::RequestError)
  end

  interface _ResumeSession
    def resume_session: (ACP::Types::ResumeSessionRequest) -> (ACP::Types::ResumeSessionResponse | ACP::RequestError)
  end

  interface _CloseSession
    def close_session: (ACP::Types::CloseSessionRequest) -> (ACP::Types::CloseSessionResponse | ACP::RequestError)
  end

  interface _DeleteSession
    def delete_session: (ACP::Types::DeleteSessionRequest) -> (ACP::Types::DeleteSessionResponse | ACP::RequestError)
  end

  interface _Logout
    def logout: (ACP::Types::LogoutRequest) -> (ACP::Types::LogoutResponse | ACP::RequestError)
  end

  interface _ForkSession
    def fork_session: (ACP::Types::Unstable::ForkSessionRequest) -> (ACP::Types::Unstable::ForkSessionResponse | ACP::RequestError)
  end

  interface _ListProviders
    def list_providers: (ACP::Types::Unstable::ListProvidersRequest) -> (ACP::Types::Unstable::ListProvidersResponse | ACP::RequestError)
  end

  interface _SetProvider
    def set_provider: (ACP::Types::Unstable::SetProviderRequest) -> (ACP::Types::Unstable::SetProviderResponse | ACP::RequestError)
  end

  interface _DisableProvider
    def disable_provider: (ACP::Types::Unstable::DisableProviderRequest) -> (ACP::Types::Unstable::DisableProviderResponse | ACP::RequestError)
  end

  interface _ChangeSessionMode
    def change_session_mode: (ACP::Types::SetSessionModeRequest) -> (ACP::Types::SetSessionModeResponse | ACP::RequestError)
  end

  interface _ChangeSessionConfigOption
    def change_session_config_option: (ACP::Types::SetSessionConfigOptionRequest) -> (ACP::Types::SetSessionConfigOptionResponse | ACP::RequestError)
  end

  interface _FullAgent
    include _Agent
    include _LoadSession
    include _ListSessions
    include _Authenticate
    include _ResumeSession
    include _CloseSession
    include _DeleteSession
    include _Logout
    include _ForkSession
    include _ListProviders
    include _SetProvider
    include _DisableProvider
    include _ChangeSessionMode
    include _ChangeSessionConfigOption
  end

  interface _SessionCreated
    def session_created: (ACP::Types::NewSessionResponse) -> void
  end

  interface _McpMessageNotification
    # Runs on the transport's reader thread, so it must return quickly.
    def mcp_message_notification: (ACP::Types::Unstable::MessageMcpNotification notification) -> void
  end
end
