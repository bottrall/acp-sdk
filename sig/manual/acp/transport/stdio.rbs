class ACP::Transport::Stdio
  # The success arm of a request handler's return: the transport serializes it
  # with to_h into the reply's result.
  interface _ToH
    def to_h: () -> Hash[String, untyped]
  end

  interface _Reader
    def each_line: () { (String) -> void } -> untyped
  end

  interface _Writer
    def write: (String) -> untyped
    def flush: () -> untyped
  end

  interface _Handler
    def call: (untyped params) -> (_ToH | ACP::RequestError | ACP::Transport::Reply)
  end

  interface _NotificationHandler
    def call: (untyped params) -> void
  end
end
