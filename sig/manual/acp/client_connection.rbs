class ACP::ClientConnection
  interface _PermissionHandler
    # Runs on its own thread, so it may block while the user decides.
    def call: (ACP::Types::RequestPermissionRequest) -> (ACP::Types::RequestPermissionResponse | ACP::RequestError)
  end

  # Receives the session/update notifications that arrive outside a
  # session_prompt or session_load call for the same session.
  interface _UpdateHandler
    # Runs on the transport's reader thread, so it must return quickly.
    def call: (ACP::Types::SessionNotification) -> void
  end
end

class ACP::ClientConnection::Streams
  # Sends the stream's request to the agent and holds the serving identity the
  # permission handler's thread restores; the connection wires its transport in.
  interface _Sender
    def request: (String method, ?untyped params) -> (Hash[String, untyped] | ACP::RequestError)
    def cancellation: () -> ACP::Transport::Cancellation?
  end
end
