#!/usr/bin/env bash
# Builds what the repo ships: the gem through `rake build`, and the Vite production bundle.
set -euo pipefail
cd "$(dirname "$0")/.."
# shellcheck source=lib/stack.sh
source bin/lib/stack.sh

parse_args no-paths -- "$@"
select_stacks "" # no paths, so no router

run_ruby() {
  if ! has_rake_task build; then
    skip_stack "no rake build task"
    return 0
  fi
  bundle exec rake build ${FLAGS[@]+"${FLAGS[@]}"}
}

# One vite.config builds the app; a repo with several bundles names one
# vite.<name>.config per bundle instead, and each is built in turn.
run_ts() {
  local config configs=()
  if has_vite_config; then
    pnpm exec vite build ${FLAGS[@]+"${FLAGS[@]}"}
    return
  fi
  for config in vite.*.config.*; do
    if [[ -f $config ]]; then configs+=("$config"); fi
  done
  if ((${#configs[@]} == 0)); then
    skip_stack "no vite.config, so no bundle to build"
    return 0
  fi
  for config in "${configs[@]}"; do
    pnpm exec vite build --config "$config" ${FLAGS[@]+"${FLAGS[@]}"} || return
  done
}

run_stacks "${STACKS[@]}"
